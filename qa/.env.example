# Copy to .env and fill in. .env is gitignored.

# --- Apps under test (both run locally, against the same Rails + DB) ---
#
# cmms — Fexy-Zamo (Rails + Ext JS desktop). Serves the Devise login form.
# pwa  — fexa-pwa (React + Vite mobile). Its dev server proxies /api, /users
#        and /main straight through to the Rails origin below, which is what
#        keeps it same-origin and makes the session cookie work unchanged.
#
# Pick which one a run targets with QA_SURFACE=cmms|pwa|both (default: both).

CMMS_BASE_URL=http://localhost:3000
PWA_BASE_URL=http://localhost:5173

# Legacy alias for CMMS_BASE_URL. Still honoured so older invocations and
# `TEST_BASE_URL=... npx playwright test` keep working; prefer CMMS_BASE_URL.
# TEST_BASE_URL=http://localhost:3000

# --- Test account credentials per role ---
# One set only. Both apps authenticate against the same Rails instance with
# the same Devise accounts — an admin is the same user with the same
# permissions whichever app they log into.
# Empty roles are skipped by global-setup (no auth file produced).

ADMIN_EMAIL=
ADMIN_PASSWORD=

VENDOR_EMAIL=
VENDOR_PASSWORD=

FACILITY_MANAGER_EMAIL=
FACILITY_MANAGER_PASSWORD=

  "model": "claude-fable-5[1m]",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/work/fexa-workflow/qa-tools/hooks/tango-dev-guard.sh\""

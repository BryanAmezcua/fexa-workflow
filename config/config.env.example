# fexa-workflow machine config — copy to ~/.config/fexa-workflow/config.env
# This is the ONLY machine/identity-specific file. Everything else is portable.
# The Jira token goes in a SEPARATE file (see JIRA_TOKEN_FILE), never here.

# --- Jira identity ---
JIRA_EMAIL="you@company.com"
JIRA_HOST="https://yourtenant.atlassian.net"
JIRA_TOKEN_FILE="$HOME/.config/fexa-workflow/jira-token"

# --- Repo locations on this machine ---
FEXA_WORKFLOW_REPO="$HOME/work/fexa-workflow"     # this repo (skills only — no engine)
FEXY_ZAMO_PATH="$HOME/work/Fexy-Zamo"             # app under test — cmms
FEXA_PWA_PATH="$HOME/work/fexa-pwa"               # app under test — pwa
TANGO_PATH="$HOME/work/TANGO"                     # the QA engine (facilitiesexchange/TANGO) — REQUIRED by fexa-qa
TANGO_BRANCH="bryan/qa"                           # personal branch on the org remote; fexa-qa never touches main
MEMORY_BANK="$FEXY_ZAMO_PATH/memory-bank"         # project context for ticket briefs (optional)

# --- Tool locations (fexa-qa exports these; non-interactive shells don't load your PATH) ---
SENCHA_CMD_DIR="$HOME/bin/Sencha/Cmd"             # dir containing the `sencha` binary of the version Fexy-Zamo pins (the Cmd/ dir, not the launcher above it)
RBENV_ROOT="$HOME/.rbenv"                         # rbenv install (shims/ and bin/ live under it)

# --- Optional overrides ---
# JIRA_ATTACHMENTS_DIR="$HOME/.cache/fexa-workflow/attachments"

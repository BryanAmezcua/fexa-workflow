# fexa-workflow machine config — copy to ~/.config/fexa-workflow/config.env
# This is the ONLY machine/identity-specific file. Everything else is portable.
# The Jira token goes in a SEPARATE file (see JIRA_TOKEN_FILE), never here.

# --- Jira identity ---
JIRA_EMAIL="you@company.com"
JIRA_HOST="https://yourtenant.atlassian.net"
JIRA_TOKEN_FILE="$HOME/.config/fexa-workflow/jira-token"

# --- Repo locations on this machine ---
FEXA_WORKFLOW_REPO="$HOME/work/fexa-workflow"     # this repo (skills only — no engine)
FEXY_ZAMO_PATH="${FEXY_ZAMO_PATH:-$HOME/work/Fexy-Zamo}"             # app under test — cmms
FEXA_PWA_PATH="${FEXA_PWA_PATH:-$HOME/work/fexa-pwa}"               # app under test — pwa
TANGO_PATH="${TANGO_PATH:-$HOME/work/TANGO}"                     # the QA engine (facilitiesexchange/TANGO); work goes on main
# ^ the three paths keep a value already exported in the shell, so a parallel
#   QA run can point them at worktrees (qa-tools/README.md).
FEXA_PWA_BRANCH="qa"                              # fexa-pwa integration branch = PWA code under test (main is production and lags)
# FEXA_QA_MIN_SLOT=1                              # slot 0 (:3000/fmdev/:5173) is the dev stack; QA claims start here
MEMORY_BANK="$FEXY_ZAMO_PATH/memory-bank"         # project context for ticket briefs (optional)

# Tool PATHs are NOT configured here: config/dev-env.sh (~/.dev-env.sh) puts rbenv, nvm,
# Sencha and Android on PATH for every shell. Check with bin/doctor.sh.

# --- Optional overrides ---
# JIRA_ATTACHMENTS_DIR="$HOME/.cache/fexa-workflow/attachments"

# fexa-workflow machine config — copy to ~/.config/fexa-workflow/config.env
# This is the ONLY machine/identity-specific file. Everything else is portable.
# The Jira token goes in a SEPARATE file (see JIRA_TOKEN_FILE), never here.

# --- Jira identity ---
JIRA_EMAIL="you@company.com"
JIRA_HOST="https://yourtenant.atlassian.net"
JIRA_TOKEN_FILE="$HOME/.config/fexa-workflow/jira-token"

# --- Repo locations on this machine ---
FEXA_WORKFLOW_REPO="$HOME/work/fexa-workflow"     # this repo (QA engine lives at <repo>/qa)
FEXY_ZAMO_PATH="$HOME/work/Fexy-Zamo"             # app under test (fexa-qa skill)
MEMORY_BANK="$FEXY_ZAMO_PATH/memory-bank"         # project context for ticket briefs (optional)

# --- Optional overrides ---
# JIRA_ATTACHMENTS_DIR="$FEXA_WORKFLOW_REPO/qa/_attachments"
